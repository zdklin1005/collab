rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMerchantNow() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    function willBeMerchant() {
      return signedIn()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    match /users/{uid} {
      allow create: if owns(uid)
        && request.resource.data.role in ['tourist', 'merchant'];
      allow read: if true;
      allow delete: if owns(uid);
      allow update: if owns(uid)
        && request.resource.data.role == resource.data.role;

      match /visitedPlaces/{placeId} {
        allow read, write: if owns(uid);
      }

      match /claimedVouchers/{voucherId} {
        allow read, write: if owns(uid);
      }

      match /friends/{friendId} {
        allow read, write: if signedIn();
      }

      match /friendRequests/{requestId} {
        allow read, write: if signedIn();
      }

      match /notes/{noteId} {
        allow read: if signedIn();
        allow write: if owns(uid);
      }
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    match /businesses/{businessId} {
      allow read: if signedIn();
      allow create: if willBeMerchant()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if willBeMerchant()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
