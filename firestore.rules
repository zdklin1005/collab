rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMerchantNow() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    function willBeMerchant() {
      return signedIn()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    match /users/{uid} {
      allow create: if owns(uid)
        && request.resource.data.role in ['tourist', 'merchant'];
      allow read: if true;
      allow delete: if owns(uid);
      allow update: if owns(uid)
        && request.resource.data.role == resource.data.role;

      match /visitedPlaces/{placeId} {
        allow read, write: if owns(uid);
      }

      // Missions are generated and completed entirely client-side
      // (MissionService), so the owning tourist needs full read/write —
      // same trust model already used for visitedPlaces above.
      match /missions/{missionId} {
        allow read, write: if owns(uid);
      }

      // Written by RewardService.awardExp()/awardVoucher() as the
      // signed-in tourist; read by whatever UI lists a tourist's vouchers.
      // NOTE: distinct from claimedVouchers below — check with the
      // merchant/voucher module owner whether these should be unified.
      match /vouchers/{voucherId} {
        allow read, write: if owns(uid);
      }

      // EXP activity log written alongside every awardExp() call.
      match /expLog/{logId} {
        allow read, write: if owns(uid);
      }

      // From main: vouchers claimed via the merchant/campaign side.
      match /claimedVouchers/{voucherId} {
        allow read, write: if owns(uid);
      }

      // From live Console (social/chat feature) — not previously in git.
      match /friends/{friendId} {
        allow read, write: if signedIn();
      }

      match /friendRequests/{requestId} {
        allow read, write: if signedIn();
      }

      match /notes/{noteId} {
        allow read: if signedIn();
        allow write: if owns(uid);
      }
    }

    // From live Console (social/chat feature) — not previously in git.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

// Landmarks are maintained through the Firebase Console.
// App users may read active landmarks but cannot modify them.
match /landmarks/{landmarkId} {
  allow read: if signedIn() && resource.data.active == true;
  allow write: if false;
}

    match /businesses/{businessId} {
    // Approval is optional for older records; missing means unapproved.
function validRewardPlacement(data) {
  return data.get('rewardPlacementApproved', false) is bool;
}

function rewardPlacementUnchanged() {
  let changed = request.resource.data.diff(resource.data).affectedKeys();

  return !changed.hasAny(['rewardPlacementApproved'])
    && (
      resource.data.get('rewardPlacementApproved', false) != true
      || !changed.hasAny(['latitude', 'longitude'])
    );
}
      allow read: if signedIn();
      allow create: if willBeMerchant()
  && request.resource.data.ownerId == request.auth.uid
  && validRewardPlacement(request.resource.data)
  && request.resource.data.get('rewardPlacementApproved', false) == false;

      // Two ways a business doc can legitimately be updated:
      // 1. The owning merchant editing their own listing (unchanged).
      // 2. ANY signed-in tourist submitting a review, which increments
      //    only reviewCount/ratingTotal (see ReviewService.submitReview).
      //    Scoped to just those two fields so a tourist can't touch
      //    name, ownerId, verificationStatus, etc.
      allow update: if validRewardPlacement(request.resource.data)
  && rewardPlacementUnchanged()
  && (
    (
      isMerchantNow()
      && resource.data.ownerId == request.auth.uid
      && request.resource.data.ownerId == request.auth.uid
    )
    ||
    (
      signedIn()
      && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reviewCount', 'ratingTotal'])
    )
  );

      allow delete: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid;

      // Reviews: anyone signed in can read; a tourist can only create a
      // review authored as themselves, and reviews are immutable once
      // posted (no update/delete) to keep ratings history honest.
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if willBeMerchant()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}