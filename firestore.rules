rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMerchantNow() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    function willBeMerchant() {
      return signedIn()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    match /users/{uid} {
      allow create: if owns(uid)
        && request.resource.data.role in ['tourist', 'merchant'];
      allow read: if true;
      allow delete: if owns(uid);
      allow update: if owns(uid)
        && request.resource.data.role == resource.data.role;

      match /visitedPlaces/{placeId} {
        allow read, write: if owns(uid);
      }

      match /claimedVouchers/{voucherId} {
        allow read, write: if owns(uid);
      }
    }

    // Landmarks are maintained through the Firebase Console.
    // App users may read active landmarks but cannot modify them.
    match /landmarks/{landmarkId} {
      allow read: if signedIn() && resource.data.active == true;
      allow write: if false;
    }

    match /businesses/{businessId} {
      allow read: if signedIn();
      allow create: if willBeMerchant()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if willBeMerchant()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isMerchantNow()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
